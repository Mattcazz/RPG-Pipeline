{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict.schema.json",
  "title": "Conflict",
  "type": "object",
  "additionalProperties": false,
  "required": ["conflict", "conflict_genre", "relationships"],
  "properties": {
    "conflict": { "type": "string", "minLength": 1 },
    "conflict_genre": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["drama", "action","horror", "comedy"] }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["characters", "description"],
        "properties": {
          "characters": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
